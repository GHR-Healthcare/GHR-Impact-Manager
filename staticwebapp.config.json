{
  "routes": [
    {
      "route": "/api/health",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ]
    },
    {
      "_comment": "The cache-refresh scheduler is a Logic App timer: it has no Entra session, so the gateway would bounce it to /.auth/login/aad and the function would never see its API key (observed as a 302 in the Logic App run history). The endpoint does its own auth instead -- CACHE_REFRESH_API_KEY, or a signed-in principal, which SWA still injects here for browser callers -- and refuses everything else.",
      "route": "/api/cache/refresh",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ]
    },
    {
      "route": "/api/*",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/*.html",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/",
      "allowedRoles": [
        "authenticated"
      ]
    },
    {
      "route": "/.auth/login/aad",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/.auth/logout",
      "allowedRoles": [
        "anonymous",
        "authenticated"
      ]
    },
    {
      "route": "/.auth/*",
      "allowedRoles": [
        "anonymous"
      ]
    },
    {
      "route": "/favicon.ico",
      "allowedRoles": [
        "anonymous"
      ]
    }
  ],
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/.auth/*",
      "/favicon.ico"
    ]
  },
  "platform": {
    "apiRuntime": "python:3.9"
  }
}